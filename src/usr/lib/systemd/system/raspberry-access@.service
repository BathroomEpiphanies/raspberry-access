[Unit]
Description=Friskola Access System %i
After=networking.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=root
Type=simple
ExecStart=/usr/bin/raspberry-access-door --database /usr/local/etc/%i.sqlite
Restart=always
RestartSec=60s
StandardOutput=append:/var/log/raspberry-access_%i.log
StandardError=append:/var/log/raspberry-access_%i.error.log
KillMode=mixed

[Install]
WantedBy=multi-user.target
